# ==============================================================================
# CONTOH KONFIGURASI ENVIRONMENT (Sesuai Slide 44 & 45)
# File ini aman untuk di-commit ke Git sebagai dokumentasi variabel yang dibutuhkan.
# Salin file ini menjadi `.env` untuk menjalankan server di mesin lokal Anda:
# cp .env.example .env
# ==============================================================================

# Port server TaskHub API (default Slide 8 & 50: 8000)
PORT=8000

# Path database SQLite untuk TaskHub
DATABASE_URL=./taskhub.db

# Kunci rahasia untuk tanda tangan HMAC webhook (Slide 45)
WEBHOOK_SECRET=super_secret_webhook_signing_key_for_lab_only_12345

# URL endpoint Provider Eksternal (Mock Service berjalan di port 8001)
PROVIDER_BASE_URL=http://127.0.0.1:8001

# Port server Provider Mock (default Slide 66: 8001)
MOCK_PORT=8001

# Path database SQLite untuk Provider Mock (penyimpanan idempotensi)
MOCK_DATABASE_URL=./provider_mock.db

# Domain frontend yang diizinkan oleh CORS (Slide 30)
ALLOWED_ORIGIN=https://app.taskhub.example.com
